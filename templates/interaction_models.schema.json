{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interaction Models",
  "type": "object",
  "required": [
    "interactions"
  ],
  "properties": {
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "trigger",
          "states",
          "feedback"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "states": {
            "type": "array"
          },
          "feedback": {
            "type": "string"
          },
          "keyboard": {
            "type": "string"
          },
          "aria": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
